# منع الوصول المباشر لملفات الإعداد والتثبيت الحساسة
<FilesMatch "^(config\.php|config\.sample\.php)$">
    Require all denied
</FilesMatch>

<Files "schema.sql">
    Require all denied
</Files>

Options -Indexes

# تعطيل ذاكرة LiteSpeed Cache (شائعة التفعيل تلقائياً على استضافات cPanel القائمة على LiteSpeed)
# لكل الموقع - بياناته ديناميكية بالكامل (كتالوج/جلسات/CSRF لكل زائر)، وتخزينها مؤقتاً على
# مستوى السيرفر نفسه قد يُبقي نسخة قديمة من الصفحة أو بيانات الكتالوج تظهر لاحقاً حتى بعد رفع
# كود جديد - ولا يُصلحه تحديث قسري من المتصفح لأن ذاكرة كهذه تعمل قبل وصول الطلب لكود PHP أصلاً.
# بلا أي أثر على استضافة لا تستخدم LiteSpeed (التوجيه يُتجاهَل بصمت إن لم تكن الوحدة موجودة)
<IfModule LiteSpeed>
CacheLookup off
</IfModule>

# رابط نظيف: /app بدل ?page=app بدون إظهار اسم index.php في شريط العنوان
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^app/?$ index.php?page=app [L,QSA]

# روابط نظيفة للوحة التحكم: /admin/categories بدل /admin/categories.php وهكذا لبقية
# الصفحات (لا تمس /admin/ نفسها، فهي مجلد حقيقي يُخدَّم عبر index.php تلقائياً من السيرفر،
# ولا تمس أي ملف أو مجلد حقيقي موجود فعلاً مثل admin/assets/)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^admin/([a-zA-Z_]+)/?$ admin/$1.php [L,QSA]
</IfModule>
