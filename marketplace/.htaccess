# رابط نظيف: يمكن فتح التطبيق من domain/app بدل domain/indexx.php
# لا يمس هذا الوصول المباشر لـ indexx.php أبداً — فقط يضيف مساراً بديلاً
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^app/?$ indexx.php [L,QSA]
</IfModule>

# حجب الوصول المباشر لملفات النسخ الاحتياطي أو أي ملفات مؤقتة إن وُجدت
<FilesMatch "\.(zip|sql|log)$">
Require all denied
</FilesMatch>
