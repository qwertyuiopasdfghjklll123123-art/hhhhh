# ============================================
# Smart E-Learning App - Server Environment
# انسخ هذا الملف إلى .env ثم عدّل القيم
# ============================================

# --- Server ---
PORT=4000
CLIENT_ORIGIN=http://localhost:5500

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_elearning

# --- Auth ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Settings encryption ---
# مفتاح 32 بايت (64 محرف hex) لتشفير مفتاح DeepSeek قبل تخزينه في قاعدة البيانات
# ولّده بأمر: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_ENCRYPTION_KEY=change_this_to_a_64_char_hex_string

# --- DeepSeek AI (احتياطي فقط: القيمة الفعلية تُدار من صفحة الإعدادات بالموقع) ---
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- YouTube Data API (اختياري: للتحقق من روابط المحاضرات وربطها فعلياً) ---
YOUTUBE_API_KEY=
