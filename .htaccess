# =====================================================================
# إعدادات أمان عامة على مستوى جذر المشروع (Apache)
# =====================================================================

# منع عرض محتويات المجلدات
Options -Indexes -MultiViews
ServerSignature Off

# منع الوصول المباشر لملفات الإعداد والبيانات الحساسة من أي مكان في المشروع
<FilesMatch "(^config\.php|^config\.sample\.php|\.sql|\.env|\.htpasswd|composer\.(json|lock))$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
</IfModule>

<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag expose_php Off
</IfModule>

# رفع حد رفع الملفات قليلاً لدعم لصق صور داخل محادثة المساعد الذكي (Vision)
<IfModule mod_php.c>
    php_value upload_max_filesize 8M
    php_value post_max_size 10M
</IfModule>

# =====================================================================
# روابط نظيفة لصفحة المشروع: /chat/{معرّف}، /code/{معرّف}، /settings/{معرّف}
# بدل project_context.php?id=X&tab=Y — تبقى الروابط القديمة تعمل أيضاً
# (project_context.php يقبل ?slug= أو ?id=) كخط رجوع إن كانت وحدة إعادة
# الكتابة غير مفعّلة على استضافتك لأي سبب.
# =====================================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^chat/([a-f0-9]{6,20})/?$ project_context.php?slug=$1&tab=chat [L,QSA]
    RewriteRule ^code/([a-f0-9]{6,20})/?$ project_context.php?slug=$1&tab=code [L,QSA]
    RewriteRule ^settings/([a-f0-9]{6,20})/?$ project_context.php?slug=$1&tab=settings [L,QSA]
</IfModule>
